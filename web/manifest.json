{
  "manifest_version": 2,
  "name": "Chat Dot — Gemini / ChatGPT / Claude / Codex",
  "version": "0.4.0",
  "description": "Знімок стола 1 у вибраний чат Gemini, ChatGPT, Claude або Codex.",
  "browser_specific_settings": {
    "gecko": {
      "id": "gemini-dot@local.invalid",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "nativeMessaging",
    "storage",
    "https://gemini.google.com/*",
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "clipboardRead",
    "clipboardWrite"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_action": {
    "default_title": "Gemini Dot",
    "default_popup": "popup.html"
  }
}
